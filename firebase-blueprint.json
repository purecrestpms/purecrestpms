{
  "entities": {
    "Property": {
      "title": "Property",
      "description": "A hospitality property managed under PCH PMS (e.g., Richgates Apartments, Enugu).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 120 },
        "code": { "type": "string", "minLength": 2, "maxLength": 24, "pattern": "^[A-Z0-9\\-]+$" },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "state": { "type": "string", "minLength": 2, "maxLength": 80 },
        "country": { "type": "string", "minLength": 2, "maxLength": 80 },
        "address": { "type": "string", "minLength": 4, "maxLength": 240 },
        "phone": { "type": "string", "minLength": 6, "maxLength": 32 },
        "whatsapp": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "logoUrl": { "type": "string", "maxLength": 350000 },
        "currency": { "type": "string", "enum": ["NGN"] },
        "usdExchangeRateNgn": { "type": "number" },
        "usdRateUpdatedIso": { "type": "string", "maxLength": 40 },
        "usdRateSource": { "type": "string", "maxLength": 64 },
        "roomCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "onboarding", "suspended"] },
        "licenseKey": { "type": "string", "maxLength": 64 },
        "licensePlan": { "type": "string", "enum": ["Starter", "Professional", "Enterprise", "Lifetime Sovereign"] },
        "adminEmail": { "type": "string", "format": "email", "maxLength": 120 },
        "authorizedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "name",
        "code",
        "city",
        "state",
        "country",
        "address",
        "currency",
        "roomCount",
        "status",
        "adminEmail",
        "authorizedEmails",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "License": {
      "title": "License",
      "description": "Centralized PureCrest software license key bound to a property or enterprise tier.",
      "type": "object",
      "properties": {
        "licenseKey": { "type": "string", "minLength": 10, "maxLength": 64, "pattern": "^PCH-[A-Z0-9\\-]+$" },
        "propertyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "propertyName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "plan": { "type": "string", "enum": ["Starter", "Professional", "Enterprise", "Lifetime Sovereign"] },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual", "lifetime"] },
        "isLifetime": { "type": "boolean" },
        "maxRooms": { "type": "number" },
        "priceNgn": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "active", "expired", "revoked"] },
        "issuedAt": { "type": "string", "maxLength": 40 },
        "activatedAt": { "type": "string", "maxLength": 40 },
        "expiresAt": { "type": "string", "maxLength": 40 },
        "activatedByEmail": { "type": "string", "maxLength": 120 },
        "authorizedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "licenseKey",
        "propertyId",
        "propertyName",
        "plan",
        "billingCycle",
        "isLifetime",
        "maxRooms",
        "priceNgn",
        "status",
        "issuedAt",
        "expiresAt",
        "authorizedEmails",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserRoleProfile": {
      "title": "UserRoleProfile",
      "description": "User RBAC profile linking verified email to portal role and assigned property.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 32 },
        "whatsapp": { "type": "string", "maxLength": 32 },
        "jobTitle": { "type": "string", "maxLength": 80 },
        "notes": { "type": "string", "maxLength": 300 },
        "role": { "type": "string", "enum": ["pch_admin", "property_admin", "front_desk", "housekeeping", "fnb_kitchen", "accountant", "maintenance"] },
        "propertyId": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "propertyId", "active", "ownerUid", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable operational and security audit log entry.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 120 },
        "actorRole": { "type": "string", "maxLength": 48 },
        "module": { "type": "string", "maxLength": 48 },
        "action": { "type": "string", "maxLength": 120 },
        "details": { "type": "string", "maxLength": 500 },
        "timestampIso": { "type": "string", "maxLength": 40 },
        "authorizedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["propertyId", "actorEmail", "actorRole", "module", "action", "details", "timestampIso", "authorizedEmails", "ownerUid", "createdAt"]
    },
    "Room": {
      "title": "Room",
      "description": "Individually managed apartment or hotel room inside a property.",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roomNumber": { "type": "string", "minLength": 1, "maxLength": 16 },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "roomType": { "type": "string", "minLength": 2, "maxLength": 64 },
        "section": { "type": "string", "enum": ["Serviced Apartment", "Hotel Rooms"] },
        "floor": { "type": "number" },
        "nightlyRateNgn": { "type": "number" },
        "maxGuests": { "type": "number" },
        "occupancyStatus": { "type": "string", "enum": ["vacant", "occupied", "reserved", "out_of_order"] },
        "housekeepingStatus": { "type": "string", "enum": ["clean", "dirty", "cleaning", "inspected"] },
        "currentGuestName": { "type": "string", "maxLength": 120 },
        "currentReservationId": { "type": "string", "maxLength": 128 },
        "imageUrl": { "type": "string", "maxLength": 350000 },
        "amenities": { "type": "array" },
        "authorizedEmails": { "type": "array" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "propertyId",
        "roomNumber",
        "name",
        "roomType",
        "floor",
        "nightlyRateNgn",
        "maxGuests",
        "occupancyStatus",
        "housekeepingStatus",
        "authorizedEmails",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "Guest": {
      "title": "Guest",
