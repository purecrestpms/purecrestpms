    // Root collection: Properties
    match /properties/{propertyId} {
      allow get: if isValidId(propertyId) && (isPchSuperAdmin() || (resource != null && isMemberResource(existing())));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && ((request.auth.token.email is string && request.auth.token.email in resource.data.authorizedEmails) || resource.data.ownerUid == request.auth.uid));
      allow create: if isValidId(propertyId) && isPchSuperAdmin() && isValidProperty(incoming()) &&
        incoming().ownerUid == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(propertyId) && isValidProperty(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (!('systemPropertyId' in existing()) || existing().systemPropertyId == '' || incoming().systemPropertyId == existing().systemPropertyId) && (
