rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core identity and static validation primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerifiedUser() &&
        request.auth.token.email is string && (
          request.auth.token.email.lower() == 'purecresthospitality@gmail.com' ||
          request.auth.token.email.lower() == 'rukevwe009@gmail.com'
        );
    }

    function isPchSuperAdmin() {
      return isBootstrappedAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'pch_admin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthorizedEmailList(arr) {
      return arr is list && arr.size() >= 1 && arr.size() <= 25 && arr[0] is string && arr[0].size() <= 120;
    }

    function isStringListMax50(arr) {
      return arr is list && arr.size() <= 50 && (arr.size() == 0 || arr[0] is string);
    }

    function isAuthorizedEmail(arr) {
      return arr is list &&
        request.auth.token.email is string && (
          request.auth.token.email in arr ||
          request.auth.token.email.lower() in arr
        );
    }

    function isMemberResource(data) {
      return isBootstrappedAdmin() || (
        isVerifiedUser() && (
          data.ownerUid == request.auth.uid ||
          isAuthorizedEmail(data.authorizedEmails)
        )
      );
    }

    function isPropertyOperator(propertyId) {
      return isPchSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid == request.auth.uid ||
          isAuthorizedEmail(get(/databases/$(database)/documents/properties/$(propertyId)).data.authorizedEmails)
        )
      );
    }

    function isPropertyAdmin(propertyId) {
      return isPchSuperAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/properties/$(propertyId)) && (
          get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerUid == request.auth.uid ||
          (
            request.auth.token.email is string &&
            get(/databases/$(database)/documents/properties/$(propertyId)).data.adminEmail.lower() == request.auth.token.email.lower()
          ) ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'property_admin' &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.propertyId == propertyId
          )
        )
      );
    }

    function isValidProperty(data) {
      return data.keys().hasAll([
        'name', 'code', 'city', 'state', 'country', 'address', 'currency',
        'roomCount', 'status', 'adminEmail', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'systemPropertyId', 'subdomainSlug', 'name', 'code', 'city', 'state', 'country', 'address', 'phone', 'whatsapp', 'email', 'logoUrl',
        'currency', 'usdExchangeRateNgn', 'usdRateUpdatedIso', 'usdRateSource',
        'roomCount', 'status', 'licenseKey', 'licensePlan', 'adminEmail',
        'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      (!('systemPropertyId' in data) || (data.systemPropertyId is string && data.systemPropertyId.size() >= 15 && data.systemPropertyId.size() <= 32 && data.systemPropertyId.matches('^PCH-PROP-[0-9]{6,}$'))) &&
      (!('subdomainSlug' in data) || (data.subdomainSlug is string && data.subdomainSlug.size() >= 2 && data.subdomainSlug.size() <= 48 && data.subdomainSlug.matches('^[a-z0-9\\-]+$'))) &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
      data.code is string && data.code.size() >= 2 && data.code.size() <= 24 && data.code.matches('^[A-Z0-9\\-]+$') &&
      data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
      data.state is string && data.state.size() >= 2 && data.state.size() <= 80 &&
      data.country is string && data.country.size() >= 2 && data.country.size() <= 80 &&
      data.address is string && data.address.size() >= 4 && data.address.size() <= 240 &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
      (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32)) &&
      (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
      (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 350000)) &&
      data.currency == 'NGN' &&
      (!('usdExchangeRateNgn' in data) || (data.usdExchangeRateNgn is number && data.usdExchangeRateNgn > 0 && data.usdExchangeRateNgn <= 100000)) &&
      (!('usdRateUpdatedIso' in data) || (data.usdRateUpdatedIso is string && data.usdRateUpdatedIso.size() <= 40)) &&
      (!('usdRateSource' in data) || (data.usdRateSource is string && data.usdRateSource.size() <= 64)) &&
      data.roomCount is number && data.roomCount >= 1 && data.roomCount <= 500 &&
      data.status in ['active', 'onboarding', 'suspended'] &&
      (!('licenseKey' in data) || (data.licenseKey is string && data.licenseKey.size() <= 64)) &&
      (!('licensePlan' in data) || (data.licensePlan is string && data.licensePlan in ['Starter', 'Professional', 'Enterprise', 'Lifetime Sovereign'])) &&
      data.adminEmail is string && data.adminEmail.size() >= 3 && data.adminEmail.size() <= 120 &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidLicense(data) {
      return data.keys().hasAll([
        'licenseKey', 'propertyId', 'propertyName', 'plan', 'billingCycle',
        'isLifetime', 'maxRooms', 'priceNgn', 'status', 'issuedAt', 'expiresAt',
        'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'licenseKey', 'propertyId', 'propertyName', 'plan', 'billingCycle',
        'isLifetime', 'maxRooms', 'priceNgn', 'status', 'issuedAt', 'activatedAt',
        'expiresAt', 'activatedByEmail', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.licenseKey is string && data.licenseKey.size() >= 10 && data.licenseKey.size() <= 64 && data.licenseKey.matches('^PCH-[A-Z0-9\\-]+$') &&
      data.propertyId is string && data.propertyId.size() >= 1 && data.propertyId.size() <= 128 &&
      data.propertyName is string && data.propertyName.size() >= 2 && data.propertyName.size() <= 120 &&
      data.plan in ['Starter', 'Professional', 'Enterprise', 'Lifetime Sovereign'] &&
      data.billingCycle in ['monthly', 'annual', 'lifetime'] &&
      data.isLifetime is bool &&
      data.maxRooms is number && data.maxRooms >= 1 && data.maxRooms <= 1000 &&
      data.priceNgn is number && data.priceNgn >= 0 &&
      data.status in ['pending', 'active', 'expired', 'revoked'] &&
      data.issuedAt is string && data.issuedAt.size() <= 40 &&
      (!('activatedAt' in data) || (data.activatedAt is string && data.activatedAt.size() <= 40)) &&
      data.expiresAt is string && data.expiresAt.size() <= 40 &&
      (!('activatedByEmail' in data) || (data.activatedByEmail is string && data.activatedByEmail.size() <= 120)) &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'propertyId', 'active', 'ownerUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'displayName', 'phone', 'whatsapp', 'jobTitle', 'notes', 'role', 'propertyId', 'active', 'ownerUid', 'createdAt', 'updatedAt']) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
      (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32)) &&
      (!('jobTitle' in data) || (data.jobTitle is string && data.jobTitle.size() <= 80)) &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
      data.role in ['pch_admin', 'property_admin', 'front_desk', 'housekeeping', 'fnb_kitchen', 'accountant', 'maintenance'] &&
      data.propertyId is string && data.propertyId.size() <= 128 &&
      data.active is bool &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['propertyId', 'actorEmail', 'actorRole', 'module', 'action', 'details', 'timestampIso', 'authorizedEmails', 'ownerUid', 'createdAt']) &&
      data.keys().hasOnly(['propertyId', 'actorEmail', 'actorRole', 'module', 'action', 'details', 'timestampIso', 'authorizedEmails', 'ownerUid', 'createdAt']) &&
      data.propertyId is string && data.propertyId.size() >= 1 && data.propertyId.size() <= 128 &&
      data.actorEmail is string && data.actorEmail.size() <= 120 &&
      data.actorRole is string && data.actorRole.size() <= 48 &&
      data.module is string && data.module.size() <= 48 &&
      data.action is string && data.action.size() <= 120 &&
      data.details is string && data.details.size() <= 500 &&
      data.timestampIso is string && data.timestampIso.size() <= 40 &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp;
    }

    function isValidRoom(data, propertyId) {
      return data.keys().hasAll([
        'propertyId', 'roomNumber', 'name', 'roomType', 'floor', 'nightlyRateNgn',
        'maxGuests', 'occupancyStatus', 'housekeepingStatus', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'propertyId', 'roomNumber', 'name', 'roomType', 'section', 'floor', 'nightlyRateNgn',
        'maxGuests', 'occupancyStatus', 'housekeepingStatus', 'currentGuestName',
        'currentReservationId', 'imageUrl', 'amenities', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.propertyId == propertyId &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 16 &&
      data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
      data.roomType is string && data.roomType.size() >= 2 && data.roomType.size() <= 64 &&
      (!('section' in data) || (data.section is string && data.section in ['Serviced Apartment', 'Hotel Rooms'])) &&
      data.floor is number && data.floor >= 0 && data.floor <= 50 &&
      data.nightlyRateNgn is number && data.nightlyRateNgn >= 1000 &&
      data.maxGuests is number && data.maxGuests >= 1 && data.maxGuests <= 12 &&
      data.occupancyStatus in ['vacant', 'occupied', 'reserved', 'out_of_order'] &&
      data.housekeepingStatus in ['clean', 'dirty', 'cleaning', 'inspected'] &&
      (!('currentGuestName' in data) || (data.currentGuestName is string && data.currentGuestName.size() <= 120)) &&
      (!('currentReservationId' in data) || (data.currentReservationId is string && data.currentReservationId.size() <= 128)) &&
      (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 350000)) &&
      (!('amenities' in data) || (data.amenities is list && data.amenities.size() <= 15 && (data.amenities.size() == 0 || data.amenities[0] is string))) &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGuest(data, propertyId) {
      return data.keys().hasAll([
        'propertyId', 'fullName', 'phone', 'idType', 'vipTier',
        'totalStays', 'lifetimeSpendNgn', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'propertyId', 'fullName', 'email', 'phone', 'address', 'city', 'state', 'country', 'nationality', 'idType', 'idNumber',
        'vipTier', 'totalStays', 'lifetimeSpendNgn', 'notes', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.propertyId == propertyId &&
      data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
      (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
      data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 32 &&
      (!('address' in data) || (data.address is string && data.address.size() <= 200)) &&
      (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
      (!('state' in data) || (data.state is string && data.state.size() <= 80)) &&
      (!('country' in data) || (data.country is string && data.country.size() <= 80)) &&
      (!('nationality' in data) || (data.nationality is string && data.nationality.size() <= 64)) &&
      data.idType in ['NIN', 'International Passport', 'Driver License', 'Voter Card'] &&
      (!('idNumber' in data) || (data.idNumber is string && data.idNumber.size() <= 64)) &&
      data.vipTier in ['Standard', 'Silver', 'Gold', 'Diplomatic'] &&
      data.totalStays is number && data.totalStays >= 0 &&
      data.lifetimeSpendNgn is number && data.lifetimeSpendNgn >= 0 &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidReservation(data, propertyId) {
      return data.keys().hasAll([
        'propertyId', 'bookingRef', 'roomId', 'roomNumber', 'guestName', 'checkInDate', 'checkOutDate',
        'nights', 'adults', 'channel', 'nightlyRateNgn', 'roomChargesNgn', 'posChargesNgn',
        'paidNgn', 'status', 'paymentMethod', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'propertyId', 'bookingRef', 'roomId', 'roomNumber', 'requestedRoomType', 'guestId', 'guestName', 'guestPhone',
        'guestEmail', 'guestAddress', 'guestCity', 'guestState', 'guestCountry',
        'checkInDate', 'checkOutDate', 'bookedDate', 'nights', 'adults', 'children', 'channel', 'nightlyRateNgn',
        'roomChargesNgn', 'posChargesNgn', 'paidNgn', 'sourceCurrency', 'sourceNightlyRate', 'sourceTotalAmount', 'fxRateToNgn',
        'paymentCollectionMode', 'otaPaidNgn', 'otaPaidSourceAmount', 'expectedPayoutNgn', 'hotelPaidNgn',
        'status', 'paymentMethod',
        'paymentConfirmed', 'idVerified', 'idType', 'idNumber', 'keyIssued', 'checkedInAtIso',
        'checkOutTime', 'lateCheckoutFeeNgn', 'lateCheckoutApplied', 'checkedOutAtIso',
        'cancellationType', 'cancellationFeeNgn', 'cancellationReason', 'cancelledAtIso', 'externalUid',
        'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.propertyId == propertyId &&
      data.bookingRef is string && data.bookingRef.size() >= 4 && data.bookingRef.size() <= 32 &&
      data.roomId is string && data.roomId.size() <= 128 &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 24 &&
      (!('requestedRoomType' in data) || (data.requestedRoomType is string && data.requestedRoomType.size() <= 64)) &&
      (!('guestId' in data) || (data.guestId is string && data.guestId.size() <= 128)) &&
      data.guestName is string && data.guestName.size() >= 2 && data.guestName.size() <= 120 &&
      (!('guestPhone' in data) || (data.guestPhone is string && data.guestPhone.size() <= 32)) &&
      (!('guestEmail' in data) || (data.guestEmail is string && data.guestEmail.size() <= 120)) &&
      (!('guestAddress' in data) || (data.guestAddress is string && data.guestAddress.size() <= 200)) &&
      (!('guestCity' in data) || (data.guestCity is string && data.guestCity.size() <= 80)) &&
      (!('guestState' in data) || (data.guestState is string && data.guestState.size() <= 80)) &&
      (!('guestCountry' in data) || (data.guestCountry is string && data.guestCountry.size() <= 80)) &&
      data.checkInDate is string && data.checkInDate.size() <= 24 &&
      data.checkOutDate is string && data.checkOutDate.size() <= 24 &&
      (!('bookedDate' in data) || (data.bookedDate is string && data.bookedDate.size() <= 24)) &&
      data.nights is number && data.nights >= 1 &&
      data.adults is number && data.adults >= 1 &&
      (!('children' in data) || (data.children is number && data.children >= 0 && data.children <= 20)) &&
      data.channel in ['Walk-in', 'Website', 'Phone', 'WhatsApp', 'Direct Walk-In', 'Direct Web', 'Booking.com', 'Airbnb', 'Expedia', 'Hotels.ng', 'VRBO', 'Custom iCal'] &&
      data.nightlyRateNgn is number && data.nightlyRateNgn >= 0 &&
      data.roomChargesNgn is number && data.roomChargesNgn >= 0 &&
      data.posChargesNgn is number && data.posChargesNgn >= 0 &&
      data.paidNgn is number && data.paidNgn >= 0 &&
      (!('sourceCurrency' in data) || (data.sourceCurrency is string && data.sourceCurrency in ['NGN', 'USD', 'GBP', 'EUR'])) &&
      (!('sourceNightlyRate' in data) || (data.sourceNightlyRate is number && data.sourceNightlyRate >= 0)) &&
      (!('sourceTotalAmount' in data) || (data.sourceTotalAmount is number && data.sourceTotalAmount >= 0)) &&
      (!('fxRateToNgn' in data) || (data.fxRateToNgn is number && data.fxRateToNgn >= 0)) &&
      (!('paymentCollectionMode' in data) || (data.paymentCollectionMode is string && data.paymentCollectionMode in ['ota_prepaid', 'hotel_collect'])) &&
      (!('otaPaidNgn' in data) || (data.otaPaidNgn is number && data.otaPaidNgn >= 0)) &&
      (!('otaPaidSourceAmount' in data) || (data.otaPaidSourceAmount is number && data.otaPaidSourceAmount >= 0)) &&
      (!('expectedPayoutNgn' in data) || (data.expectedPayoutNgn is number && data.expectedPayoutNgn >= 0)) &&
      (!('hotelPaidNgn' in data) || (data.hotelPaidNgn is number && data.hotelPaidNgn >= 0)) &&
      data.status in ['confirmed', 'pending', 'checked_in', 'checked_out', 'cancelled', 'no_show'] &&
      data.paymentMethod in ['Bank Transfer', 'Card POS', 'Cash NGN', 'Corporate Invoice', 'Online Gateway'] &&
      (!('paymentConfirmed' in data) || data.paymentConfirmed is bool) &&
      (!('idVerified' in data) || data.idVerified is bool) &&
      (!('idType' in data) || (data.idType is string && data.idType in ['NIN', 'International Passport', 'Driver License', 'Voter Card'])) &&
      (!('idNumber' in data) || (data.idNumber is string && data.idNumber.size() <= 64)) &&
      (!('keyIssued' in data) || data.keyIssued is bool) &&
      (!('checkedInAtIso' in data) || (data.checkedInAtIso is string && data.checkedInAtIso.size() <= 40)) &&
      (!('checkOutTime' in data) || (data.checkOutTime is string && data.checkOutTime.size() <= 16)) &&
      (!('lateCheckoutFeeNgn' in data) || (data.lateCheckoutFeeNgn is number && data.lateCheckoutFeeNgn >= 0)) &&
      (!('lateCheckoutApplied' in data) || data.lateCheckoutApplied is bool) &&
      (!('checkedOutAtIso' in data) || (data.checkedOutAtIso is string && data.checkedOutAtIso.size() <= 40)) &&
      (!('cancellationType' in data) || (data.cancellationType is string && data.cancellationType in ['free', 'paid'])) &&
      (!('cancellationFeeNgn' in data) || (data.cancellationFeeNgn is number && data.cancellationFeeNgn >= 0)) &&
      (!('cancellationReason' in data) || (data.cancellationReason is string && data.cancellationReason.size() <= 240)) &&
      (!('cancelledAtIso' in data) || (data.cancelledAtIso is string && data.cancelledAtIso.size() <= 40)) &&
      (!('externalUid' in data) || (data.externalUid is string && data.externalUid.size() <= 160)) &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidHousekeepingTask(data, propertyId) {
      return data.keys().hasAll(['propertyId', 'roomId', 'roomNumber', 'taskType', 'assignedTo', 'priority', 'status', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['propertyId', 'roomId', 'roomNumber', 'taskType', 'assignedTo', 'priority', 'status', 'notes', 'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt']) &&
      data.propertyId == propertyId &&
      data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
      data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 16 &&
      data.taskType in ['Checkout Turnover', 'Daily Stayover', 'Deep Clean', 'VIP Inspection'] &&
      data.assignedTo is string && data.assignedTo.size() <= 80 &&
      data.priority in ['Normal', 'High', 'Urgent'] &&
      data.status in ['pending', 'in_progress', 'completed', 'inspected'] &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPosOrder(data, propertyId) {
      return data.keys().hasAll([
        'propertyId', 'orderNumber', 'serviceType', 'tableOrRoom', 'itemsSummary', 'itemCount',
        'subtotalNgn', 'vatNgn', 'totalNgn', 'paymentStatus', 'paymentMethod', 'kitchenStatus',
        'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'propertyId', 'orderNumber', 'orderDate', 'serviceType', 'tableOrRoom', 'guestName', 'reservationId', 'itemsSummary', 'itemCount',
        'subtotalNgn', 'vatNgn', 'totalNgn', 'paymentStatus', 'paymentMethod', 'kitchenStatus', 'notes',
        'authorizedEmails', 'ownerUid', 'createdAt', 'updatedAt'
      ]) &&
      data.propertyId == propertyId &&
      data.orderNumber is string && data.orderNumber.size() >= 3 && data.orderNumber.size() <= 32 &&
      (!('orderDate' in data) || (data.orderDate is string && data.orderDate.size() <= 24)) &&
      data.serviceType in ['Dine-In', 'Room Service', 'Bar Lounge', 'Takeaway'] &&
      data.tableOrRoom is string && data.tableOrRoom.size() >= 1 && data.tableOrRoom.size() <= 64 &&
      (!('guestName' in data) || (data.guestName is string && data.guestName.size() <= 120)) &&
      (!('reservationId' in data) || (data.reservationId is string && data.reservationId.size() <= 128)) &&
      data.itemsSummary is string && data.itemsSummary.size() >= 2 && data.itemsSummary.size() <= 400 &&
      data.itemCount is number && data.itemCount >= 1 &&
      data.subtotalNgn is number && data.subtotalNgn >= 0 &&
      data.vatNgn is number && data.vatNgn >= 0 &&
      data.totalNgn is number && data.totalNgn >= 0 &&
      data.paymentStatus in ['paid', 'room_folio', 'unpaid'] &&
      data.paymentMethod in ['Room Folio', 'Card POS', 'Bank Transfer', 'Cash NGN'] &&
      data.kitchenStatus in ['queued', 'preparing', 'ready', 'served'] &&
      (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
      isAuthorizedEmailList(data.authorizedEmails) &&
      data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidPosMenuItem(data, propertyId) {
      return data.keys().hasAll([
        'propertyId', 'name', 'category', 'priceNgn', 'prepMinutes', 'available',
