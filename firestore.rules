          isPchSuperAdmin() || (
            incoming().role != 'pch_admin' &&
            isPropertyAdmin(incoming().propertyId)
          )
        );
      allow update: if isValidId(userId) && isVerifiedUser() && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid && incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time && (
          isPchSuperAdmin() || (
            request.auth.uid == userId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'whatsapp', 'jobTitle', 'notes', 'updatedAt'])
          ) || (
            incoming().role != 'pch_admin' &&
            isPropertyAdmin(existing().propertyId)
          )
        );
      allow delete: if isValidId(userId) && isPchSuperAdmin();
    }

    // Root collection: Append-Only Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && (isPchSuperAdmin() || (resource != null && isMemberResource(existing())));
      allow list: if isBootstrappedAdmin() || (isVerifiedUser() && ((request.auth.token.email is string && request.auth.token.email in resource.data.authorizedEmails) || resource.data.ownerUid == request.auth.uid));
      allow create: if isValidId(logId) && isVerifiedUser() && isValidAuditLog(incoming()) &&
        incoming().ownerUid == request.auth.uid && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // Root collection: Global Application CMS Config (PCH Super Admin writable)
    match /app_cms/{cmsId} {
      allow get: if isValidId(cmsId) && cmsId == 'global' && isVerifiedUser();
      allow list: if false;
      allow create: if isValidId(cmsId) && cmsId == 'global' && isPchSuperAdmin() &&
        isValidCmsConfig(incoming()) && incoming().ownerUid == request.auth.uid &&
        incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(cmsId) && cmsId == 'global' && isPchSuperAdmin() &&
        isValidCmsConfig(incoming()) && incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(cmsId) && cmsId == 'global' && isPchSuperAdmin();
    }

    // Root collection: Public Plan Purchases & Contact Inquiries (admin read-only)
    match /plan_inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isPchSuperAdmin();
      allow list: if isPchSuperAdmin();
      allow create: if isValidId(inquiryId) && isValidPlanInquiry(incoming()) &&
        incoming().status == 'new' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(inquiryId) && isPchSuperAdmin() &&
        isValidPlanInquiry(incoming()) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(inquiryId) && isPchSuperAdmin();
    }
  }
}
